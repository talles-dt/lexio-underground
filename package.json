{
  "name": "lexio-underground",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "next dev",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "build": "NODE_OPTIONS='--input-type=module' next build",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo/universal",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "testMatch": [
      "**/*.test.ts?(x)",
      "**/*.test.js?(x)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "transform": {
      "^.+\\.[tj]sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ]
  },
  "type": "module",
  "dependencies": {
    "@expo/metro-runtime": "^56.0.13",
    "@react-navigation/bottom-tabs": "^7.3.13",
    "@react-navigation/native": "^7.1.9",
    "@stripe/stripe-js": "^9.7.0",
    "@stripe/stripe-react-native": "^0.66.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tremor/react": "^3.18.7",
    "ajv": "^8.20.0",
    "dotenv": "^8.2.0",
    "expo": "~54.0.33",
    "expo-av": "~16.0.8",
    "expo-clipboard": "^56.0.3",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "^56.0.11",
    "expo-notifications": "~0.32.17",
    "expo-router": "2.0.15",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "next": "^16.2.6",
    "nodemailer": "^8.0.8",
    "prettier": "^3.8.3",
    "react": "19.1.0",
    "react-dom": "^19.2.6",
    "react-native": "^0.73.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.2",
    "resend": "^6.12.3",
    "stream": "^0.0.3",
    "tamagui": "^2.0.0",
    "url": "^0.11.4",
    "url-parse": "^1.5.10",
    "util": "^0.12.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@expo/metro-config": "^56.0.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^56.0.12",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "events": "^3.3.0",
    "jest": "29.4",
    "metro-react-native-babel-transformer": "^0.77.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2"
  },
  "private": true
}
